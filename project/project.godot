; Bludleigh — a Mulliner story as a 3D graphic novel.
; Godot 4.4

config_version=5

[application]

config/name="Bludleigh"
config/description="Two gentle poets visit a house that has been killing things for four hundred years. A 3D graphic novel after P. G. Wodehouse."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.937, 0.906, 0.839, 1)
boot_splash/show_image=false

[editor]

; Movie Maker mode (--write-movie): every frame rendered, at this rate, however
; long it takes. build.sh turns the MJPEG into an MP4.
movie_writer/fps=24
movie_writer/mjpeg_quality=0.9
movie_writer/disable_vsync=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; Native builds: a resizable window, and the OS' screen scale is respected.
window/size/resizable=true
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
; "expand": in a browser the canvas is whatever shape the window is.
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

; Apple-silicon (universal) exports need it; the textures are 160 px drawings, so it costs nothing.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
; No Vulkan in a browser; web and mobile run Compatibility, which is also what
; the pages were lit against.
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
; 2x MSAA, and main.gd caps the 3D render at ~2 megapixels: on a Retina screen
; 4x MSAA at full resolution was ~250 MB of GPU memory before any scenery, and
; the browser dropped the WebGL context a few pages in. Lettering stays full-res.
anti_aliasing/quality/msaa_3d=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/positional_shadow/atlas_size=512
lights_and_shadows/positional_shadow/atlas_size.mobile=512
